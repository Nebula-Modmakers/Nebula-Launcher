<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profiles_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_nebula_screen">

    <LinearLayout
        android:id="@+id/profiles_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/profiles_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_nebula_button"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Profiles"
                android:textColor="#F0F3FF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profiles_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#8790B9"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/profiles_create"
            android:layout_width="132dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_nebula_button"
            android:text="New profile"
            android:textAllCaps="false"
            android:textColor="#F0F3FF"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="8dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/profiles_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
