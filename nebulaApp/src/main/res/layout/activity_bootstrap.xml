<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bootstrap_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_nebula_screen"
    android:padding="24dp">

    <TextView
        android:id="@+id/bootstrap_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="NEBULA"
        android:textColor="#F0F3FF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/bootstrap_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="NATIVE ANDROID"
        android:textColor="#7DD3FC"
        android:textSize="11sp"
        android:textStyle="bold" />

    <dev.tates.nebula.NebulaLoaderView
        android:id="@+id/bootstrap_progress"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="18dp" />

    <TextView
        android:id="@+id/bootstrap_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_nebula_card"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/bootstrap_status_preparing"
        android:textColor="#D6EAFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/bootstrap_download_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:max="100"
        android:indeterminate="false"
        android:progress="0"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bootstrap_progress_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="#8790B9"
        android:textSize="12sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/bootstrap_log_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_nebula_card"
        android:fillViewport="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/bootstrap_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:textColor="#B9F6FF"
            android:textIsSelectable="true"
            android:textSize="10sp"
            android:typeface="monospace" />
    </ScrollView>

</LinearLayout>

