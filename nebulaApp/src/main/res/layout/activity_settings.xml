<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_nebula_screen"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/settings_action_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="18dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_nebula_button"
            android:scaleType="centerInside"
            android:contentDescription="@string/settings_action_back" />

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="#F0F3FF"
            android:textSize="28sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

    <LinearLayout
        android:id="@+id/settings_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_nebula_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verbose launch"
                android:textColor="#F0F3FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Show the live BepInEx log while the game starts."
                android:textColor="#8790B9"
                android:textSize="12sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/settings_verbose_launch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Verbose launch" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_nebula_card"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_runtime_title"
                android:textColor="#F0F3FF"
                android:textSize="16sp"
                android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:text="@string/settings_runtime_desc"
            android:textColor="#8790B9"
            android:textSize="12sp" />

            <Button
                android:id="@+id/settings_replace_game_zip"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_nebula_button"
                android:text="Open Among Us in Google Play"
                android:textAllCaps="false"
                android:textColor="#F0F3FF"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_nebula_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Account"
            android:textColor="#F0F3FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Manage Nebula login and Innersloth account linking."
            android:textColor="#8790B9"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settings_account_link"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nebula_button"
                android:text="Link Innersloth"
                android:textAllCaps="false"
                android:textColor="#F0F3FF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/settings_logout"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nebula_button"
                android:text="Log Out"
                android:textAllCaps="false"
                android:textColor="#F0F3FF"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/settings_authorized_devices"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_nebula_button"
            android:text="Authorized Devices"
            android:textAllCaps="false"
            android:textColor="#F0F3FF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_delete_account"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_nebula_button"
            android:text="Delete Account"
            android:textAllCaps="false"
            android:textColor="#FFFF8A9A"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_nebula_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Storage"
            android:textColor="#F0F3FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Use Browse Files from the launcher to edit shared runtime, game, profile, and mod folders."
            android:textColor="#8790B9"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/settings_about_nebula"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_nebula_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About Nebula"
            android:textColor="#F0F3FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Native Android launcher UI for Nebula accounts, mods, and Among Us runtime compatibility."
            android:textColor="#8790B9"
            android:textSize="12sp" />
    </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
