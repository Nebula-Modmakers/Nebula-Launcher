<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/file_browser_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_nebula_screen"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/file_browser_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_nebula_button"
            android:contentDescription="@string/settings_action_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/file_browser_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:text="Nebula Files"
            android:textColor="#F0F3FF"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/file_browser_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_nebula_card"
        android:padding="14dp"
        android:textColor="#9AA7D6"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/file_browser_up"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nebula_button"
            android:text="@string/file_browser_up"
            android:textAllCaps="false"
            android:textColor="#F0F3FF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/file_browser_refresh"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nebula_button"
            android:text="@string/file_browser_refresh"
            android:textAllCaps="false"
            android:textColor="#F0F3FF"
            android:textStyle="bold" />
    </LinearLayout>

    <ListView
        android:id="@+id/file_browser_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_nebula_card"
        android:cacheColorHint="@android:color/transparent"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:padding="12dp" />

</LinearLayout>
